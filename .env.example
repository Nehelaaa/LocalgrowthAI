# App
AUTH_SECRET="generate with: openssl rand -base64 32"
# Vercel: some projects use NEXTAUTH_SECRET instead — both are supported (see src/lib/auth.ts).
# Shown on generated invoices (PDF + plain text). Optional.
# NEXT_PUBLIC_INVOICE_COMPANY_NAME=Localleadster
# Production / preview: set to your canonical origin (https://your-domain.com), matching how users open the app
# (if you use www, set https://www.example.com — not only the apex, or OAuth / CSRF can misbehave).
# Local dev: you can omit AUTH_URL — the app clears it in development so OAuth uses
# whatever host:port you opened (fixes "stuck" Google when Next uses 3001, etc.).
# If you need a fixed dev URL (tunnel), set AUTH_URL and AUTH_KEEP_URL=1.
# AUTH_URL="http://localhost:3000"
#
# Optional: public canonical URL for SEO (sitemap, JSON-LD, metadataBase) when it should differ from AUTH_URL.
# NEXT_PUBLIC_SITE_URL="https://localleadster.com"
# Optional: Google Search Console HTML tag verification (content value only, not the full tag).
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION="your-verification-string"
# Optional comma-separated extra origins for CSRF checks on JSON POST routes (Stripe checkout, etc.).
# www vs non-www of AUTH_URL and the URL you opened are already allowed without this.
# ALLOWED_ORIGINS=https://preview.example.com
# Neon: use the **Pooled** connection for DATABASE_URL (Prisma runtime / serverless).
# Example: postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require&pgbouncer=true
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.neon.tech/neondb?sslmode=require&pgbouncer=true"
# If Prisma errors with P1001 to the *pooler* host locally only, set to 1 to use DIRECT_URL for queries (dev workaround).
# PRISMA_USE_DIRECT_URL=1
#
# **Direct** (non-pooled) URL for migrations — same DB, host usually WITHOUT `-pooler`.
# Required on Vercel (Production + Preview if those builds run migrate): without DIRECT_URL, deploy fails with
# P1002 “advisory lock” timeouts because migrate would use the pooler.
# In Neon: Connection details → “Direct connection” (not “Pooled”).
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.neon.tech/neondb?sslmode=require"
# Vercel build P1001 (“Can’t reach database”): Neon may be suspended — open the Neon dashboard once to wake it,
# or redeploy after a minute. Optional: PRISMA_MIGRATE_MAX_ATTEMPTS=8 PRISMA_MIGRATE_RETRY_DELAY_MS=8000

# Google sign-in ("Continue with Google" on /login) — set BOTH or the button stays hidden
# Create OAuth 2.0 > Web at https://console.cloud.google.com/apis/credentials
# Authorized redirect URIs (add every host + port you use in the browser):
#   http://localhost:3000/api/auth/callback/google
#   http://localhost:3001/api/auth/callback/google
#   http://127.0.0.1:3000/api/auth/callback/google
# Authorized JavaScript origins (same hosts, no /callback path):
#   http://localhost:3000
#   http://localhost:3001
#   http://127.0.0.1:3000
# If OAuth consent is "Testing", add each Google account under "Test users" or the flow can hang or fail.
#
# redirect_uri_mismatch → Authorized redirect URI must be exactly:
#   <AUTH_URL origin>/api/auth/callback/google
# e.g. https://your-project.vercel.app/api/auth/callback/google
# JavaScript origin is just https://your-project.vercel.app (no path, no trailing slash).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Places + OpenAI (app features)
GOOGLE_PLACES_API_KEY=
# Same Maps Platform key: enable "Geocoding API" in Google Cloud so city/state centers correctly for radius searches.
OPENAI_API_KEY=
# Owner /owner/costs: estimated $ per Google Text Search API hit and per AI call (tune to your real bills)
# GOOGLE_COST_PER_SEARCH_USD=0.017
# AI_COST_PER_CALL_USD=0.02

# Stripe (SaaS billing) — get keys from https://dashboard.stripe.com
# Vercel/production: use these exact names, or the _LIVE aliases below (code accepts both).
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID_PRO=price_...
# Optional aliases (same values as above if you split local vs prod naming) — these are what the server reads:
# STRIPE_SECRET_KEY_LIVE=
# STRIPE_WEBHOOK_SECRET_LIVE=
# STRIPE_PRICE_ID_PRO_LIVE=
# Must be a recurring Price id (price_…), never a Product id (prod_…).
# Publishable key is not used by current server-side Checkout; optional for future client Stripe.js:
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY_LIVE=
# You can remove from Vercel if unused: STRIPE_MK_ID, STRIPE_RESTRICTED_KEY_LIVE_UNUSED
# Optional: “API key ID” from Standard key ⋮ menu (mk_…) — not the secret key; this app does not require it
# STRIPE_MK_ID=mk_...
# The Pro price in Stripe must be a recurring (subscription) price.
#
# Going live: DB rows may still hold test-mode `cus_` / `sub_` ids. The app clears stale IDs when Stripe
# returns resource_missing so customers can subscribe again with live keys.
#
# Webhooks: create an endpoint to https://<your-domain>/api/stripe/webhook (e.g. https://localleadster.com/api/stripe/webhook)
# and subscribe to the events listed in src/lib/billing-policies.ts (stripeWebhookEventsRecommended).
# Copy the destination signing secret (whsec_…) to STRIPE_WEBHOOK_SECRET. Prefer the same API version as
# src/lib/stripe.ts (STRIPE_API_VERSION). Enable Customer portal (Settings → Customer portal) so subscribers
# can cancel, update payment methods, and download invoices.
#
# Optional: publishable key (pk_test_... / pk_live_...). This app uses server-side Checkout only,
# so nothing reads this today. Add as NEXT_PUBLIC_... if you later use Stripe.js / Elements in the client.
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
#
# Stripe hosted UI — see `src/lib/stripe-branding.ts`.
#
# Checkout (subscribe): themed via env below + optional `/icon.svg` and `/logo.svg` on your domain.
# In Stripe Dashboard → Brand elements → Checkout, set Brand color ≠ Accent (same hex = muddy UI).
# STRIPE_BRAND_DISPLAY_NAME=Localleadster
# STRIPE_CHECKOUT_BACKGROUND_COLOR=#f1f5f9
# STRIPE_CHECKOUT_BUTTON_COLOR=#4f46e5
# STRIPE_CHECKOUT_BRAND_IMAGES=0   # set to 0 to skip passing /icon.svg + /logo.svg URLs to Checkout
# STRIPE_CHECKOUT_ICON_URL=https://your-domain.com/icon.svg
# STRIPE_CHECKOUT_LOGO_URL=https://your-domain.com/logo.svg
#
# Customer portal (“Manage billing” / partners-with-Stripe page): NOT controlled by these vars.
# Customize logo + business name + colors in Stripe Dashboard → Settings → Branding:
#   https://dashboard.stripe.com/settings/branding
# Optional portal features (cancel, invoices, etc.) → Billing → Customer portal; then:
# STRIPE_BILLING_PORTAL_CONFIGURATION_ID=bpc_...

# Password reset (Resend — https://resend.com). Without RESEND_API_KEY, /forgot-password
# only works in local dev (reset link is printed in the terminal).
# RESEND_API_KEY=
# EMAIL_FROM="LocalLeadster <onboarding@resend.dev>"
# Inbox for /dashboard/support and contact forms (defaults to support@localleadster.com in code).
# Set this if you use a different mailbox or forwarding address.
# SUPPORT_INBOX_EMAIL=support@localleadster.com

# Product analytics (PostHog) — optional. Without these, analytics is a no-op.
# Create a project at https://posthog.com → Project Settings → Project API Key.
# NEXT_PUBLIC_POSTHOG_KEY=phc_...
# US cloud host (default if unset): https://us.i.posthog.com
# EU cloud: https://eu.i.posthog.com
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
