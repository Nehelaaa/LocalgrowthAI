# App
AUTH_SECRET="generate with: openssl rand -base64 32"
# Production / preview: set to your canonical origin (https://your-domain.com).
# Local dev: you can omit AUTH_URL — the app clears it in development so OAuth uses
# whatever host:port you opened (fixes "stuck" Google when Next uses 3001, etc.).
# If you need a fixed dev URL (tunnel), set AUTH_URL and AUTH_KEEP_URL=1.
# AUTH_URL="http://localhost:3000"
# Neon: use the "Pooled" connection from the dashboard, and add &pgbouncer=true for Prisma
# Example: postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require&pgbouncer=true
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx.neon.tech/neondb?sslmode=require&pgbouncer=true"

# Google sign-in ("Continue with Google" on /login) — set BOTH or the button stays hidden
# Create OAuth 2.0 > Web at https://console.cloud.google.com/apis/credentials
# Authorized redirect URIs (add every host + port you use in the browser):
#   http://localhost:3000/api/auth/callback/google
#   http://localhost:3001/api/auth/callback/google
#   http://127.0.0.1:3000/api/auth/callback/google
# Authorized JavaScript origins (same hosts, no /callback path):
#   http://localhost:3000
#   http://localhost:3001
#   http://127.0.0.1:3000
# If OAuth consent is "Testing", add each Google account under "Test users" or the flow can hang or fail.
#
# redirect_uri_mismatch → Authorized redirect URI must be exactly:
#   <AUTH_URL origin>/api/auth/callback/google
# e.g. https://your-project.vercel.app/api/auth/callback/google
# JavaScript origin is just https://your-project.vercel.app (no path, no trailing slash).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Places + OpenAI (app features)
GOOGLE_PLACES_API_KEY=
OPENAI_API_KEY=

# Stripe (SaaS billing) — get keys from https://dashboard.stripe.com
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID_PRO=price_...
# The Pro price in Stripe must be a recurring (subscription) price.

# Password reset (Resend — https://resend.com). Without RESEND_API_KEY, /forgot-password
# only works in local dev (reset link is printed in the terminal).
# RESEND_API_KEY=
# EMAIL_FROM="LocalGrowth AI <onboarding@resend.dev>"
