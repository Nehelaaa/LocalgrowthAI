# Copy to `.env.test` (gitignored) for local integration tests.
#
# Option A — Docker (recommended if Docker Desktop is installed):
#   docker compose -f docker-compose.test.yml up -d
#   DATABASE_URL="postgresql://postgres:postgres@localhost:54329/localleadster_test?schema=public"
#   DIRECT_URL="$DATABASE_URL"
#
# Option B — Dedicated Neon project/branch (never your production DATABASE_URL):
#   DATABASE_URL="postgresql://...-pooler.../neondb?sslmode=require&pgbouncer=true"
#   DIRECT_URL="postgresql://.../neondb?sslmode=require"
#
# Then: npx prisma migrate deploy && npm run test:integration

DATABASE_URL=
DIRECT_URL=
